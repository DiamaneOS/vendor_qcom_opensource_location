
cc_library_headers {

    name: "libloc_api_v02_headers",
    export_include_dirs: ["."],
    vendor: true,
}

// The QMI LOC client. The QMI client (QCCI) and the common QMI types come
// from the public QMI framework, linked in statically; qmi_shim maps the
// names this library uses onto it.
cc_library_shared {

    name: "libloc_api_v02",
    vendor: true,

    srcs: [
        "LocApiV02.cpp",
        "loc_api_v02_log.cpp",
        "loc_api_v02_client.cpp",
        "loc_api_sync_req.cpp",
        "location_service_v02.c",
    ],

    local_include_dirs: ["qmi_shim"],

    header_libs: [
        "libloc_core_headers",
        "libgps.utils_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
        "qmi_framework_headers",
    ],

    static_libs: [
        "libqmi_framework_cci",
        "libqmi_framework_common",
    ],

    shared_libs: [
        "libutils",
        "libcutils",
        "libloc_core",
        "libgps.utils",
        "libdl",
        "liblog",
    ],

    cflags: [
        "-fno-short-enums",
        "-D_ANDROID_",
    ] + GNSS_CFLAGS,
}
